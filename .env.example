# Copiar a .env y completar. .env nunca entra en Git.

# Cloudflare R2: token S3 con lectura y escritura de objetos, restringido al bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=argentina-fx-research

# Opcionales
# ARGFX_STORAGE=auto          # auto | r2 | local (auto usa R2 si hay credenciales)
# ARGFX_DATA_DIR=data         # caché local DuckDB/Parquet y almacén local offline
# ARGFX_MANIFESTS_DIR=manifests
